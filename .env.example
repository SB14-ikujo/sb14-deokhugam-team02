# 이 파일을 .env.local 로 복사한 뒤 POSTGRES_PASSWORD 칸을 채워 주십시오. (운영 값은 .env.prod)

POSTGRES_DB=deokhugam
POSTGRES_USER=deokhugam
POSTGRES_PASSWORD=change-me

# AWS
AWS_S3_ACCESS_KEY=
AWS_S3_SECRET_KEY=
AWS_S3_REGION=
AWS_S3_BUCKET=
AWS_S3_PRESIGNED_URL_EXPIRATION=600

# 이미지 저장소 유형 (기본값: local / 선택 가능: local, s3)
STORAGE_TYPE=

# 로컬 이미지 저장 경로 (기본값: ./uploads, 변경 시 .gitignore에 경로 추가 필요)
STORAGE_PATH=

# OCR Space
OCR_SPACE_API_KEY=
